      "rule_sha256": "fd87990871c3324c5e3eb20b4cd6cede336e23cbe3c1a35307b7894581869f24",
      "query": "SELECT * FROM logs WHERE (Image LIKE '%\\\\whoami.exe' ESCAPE '\\' OR OriginalFileName='whoami.exe') AND (CommandLine LIKE '% -all%' ESCAPE '\\' OR CommandLine LIKE '% /all%' ESCAPE '\\' OR CommandLine LIKE '% \u2013all%' ESCAPE '\\' OR CommandLine LIKE '% \u2014all%' ESCAPE '\\' OR CommandLine LIKE '% \u2015all%' ESCAPE '\\')",
