      "rule_id": "97a80ec7-0e2f-4d05-9ef4-65760e634f6b",
      "title": "Security Privileges Enumeration Via Whoami.EXE",
      "author": "Florian Roth (Nextron Systems)",
      "rule_sha256": "551440eda804b85d85b68f2b283058ab8286c3c3b1da06c262ca1437fa2558a7",
      "query": "SELECT * FROM logs WHERE (Image LIKE '%\\\\whoami.exe' ESCAPE '\\' OR OriginalFileName='whoami.exe') AND (CommandLine LIKE '% /priv%' ESCAPE '\\' OR CommandLine LIKE '% -priv%' ESCAPE '\\')",
      "results": [
